# Copy to config.env (git-ignored) and fill in.

# Your iPhone's UDID: `pymobiledevice3 usbmux list` (with the cable plugged in)
UDID="00008130-XXXXXXXXXXXXXXXX"

# Leave empty to find the iPhone on the local Wi-Fi (same network as this machine).
# Set it to the iPhone's Tailscale IP (100.x.x.x) to launch from anywhere, e.g. a cloud server.
IPHONE_IP=""

# Only needed when this machine is NOT the one you paired from: the paired machine's
# hostname (run `hostname` there). The iPhone pins a host ID derived from it.
HUD_PAIR_HOST=""

# Python of the pymobiledevice3 install (this is pipx's default location).
# PY="$HOME/.local/share/pipx/venvs/pymobiledevice3/bin/python"
